{
  "name": "moo-daeng-pos",
  "account_id": "e9992412fcfd4b91eb138afac9be9abf",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Only these go through the Worker (and count as Worker requests); other static files are served directly.
    "run_worker_first": ["/api/*", "/", "/kitchen", "/kitchen.html"]
  },
  "durable_objects": {
    "bindings": [{ "name": "SHOP", "class_name": "ShopDO" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ShopDO"] }],

  // Staging: deploy only with `wrangler deploy --env staging` (npm run deploy:staging).
  // Wrangler does NOT inherit assets/durable_objects/migrations/vars into an environment, so they are repeated here.
  // This environment belongs to this restaurant's staging Worker. Its Durable
  // Object namespace is separate from production; no old-shop data is shared or copied.
  "env": {
    "staging": {
      "name": "moo-daeng-pos-staging",
      "assets": {
        "directory": "./public",
        "binding": "ASSETS",
        "run_worker_first": ["/api/*", "/", "/kitchen", "/kitchen.html"]
      },
      "durable_objects": {
        "bindings": [{ "name": "SHOP", "class_name": "ShopDO" }]
      },
      "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ShopDO"] }],
      "vars": {
        "AUTH_MODE": "enforce",
        "BELL_ENABLED": "true",
        "FIREBASE_DATABASE_URL": "https://thongyoibell-default-rtdb.asia-southeast1.firebasedatabase.app"
      }
    }
  }
}
