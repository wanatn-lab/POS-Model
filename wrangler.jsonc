{
  // SAFETY: this repository is the central/template system. It must NEVER deploy to the Jinko production
  // Worker "order". A plain `wrangler deploy` targets only "jinko-central-staging" (not production).
  // `wrangler deploy --env staging` targets "thongyoi". Read DEPLOY.md before any deploy.
  "name": "jinko-central-staging",
  "account_id": "040db9c5b9960d8500349fd4958bded8",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Only these go through the Worker (and count as Worker requests); other static files are served directly.
    "run_worker_first": ["/api/*", "/", "/kitchen", "/kitchen.html"]
  },
  "durable_objects": {
    "bindings": [{ "name": "SHOP", "class_name": "ShopDO" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ShopDO"] }],

  // Staging: deploy only with `wrangler deploy --env staging` (npm run deploy:staging).
  // Wrangler does NOT inherit assets/durable_objects/migrations/vars into an environment, so they are repeated here.
  // The Durable Object has no script_name, so its namespace belongs to the worker that runs it ("thongyoi" here,
  // "jinko-central-staging" for a plain deploy). Its SQLite storage is separate from Jinko production ("order").
  // No data is shared or copied.
  "env": {
    "staging": {
      "name": "thongyoi",
      "assets": {
        "directory": "./public",
        "binding": "ASSETS",
        "run_worker_first": ["/api/*", "/", "/kitchen", "/kitchen.html"]
      },
      "durable_objects": {
        "bindings": [{ "name": "SHOP", "class_name": "ShopDO" }]
      },
      "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ShopDO"] }],
      "vars": { "AUTH_MODE": "log" }
    }
  }
}
